rules_version = '2';

// ===============================================================
// LOG US Firestore 보안 규칙 (기본 거부)
// ===============================================================
// 데이터 모델은 CLAUDE.md "데이터 모델"을 따른다. 여기에 없는 경로는 모두 거부된다.
// 규칙을 바꾸면 tests/rules/firestore.test.ts도 함께 고치고 `npm run test:rules`로 확인한다.
//
// 서버 함수(Admin SDK)는 이 규칙을 거치지 않는다. 그래서 아래 쓰기는 클라이언트에게 막혀 있고
// 서버 함수로만 일어난다.
//   - journeys 문서와 members 문서 생성·참여·삭제·나가기 → createJourney, joinJourney, deleteJourney, leaveJourney
//   - 기록의 location·placeName·isPublic → saveLogLocation
//   - users.coins, coinLedger, coinDaily(하루 50코인 제한) → saveLogLocation, joinJourney
//   - 광고 코인(users.coins, coinLedger ad_*, adDaily 하루 5번) → claimAdReward (adDaily 는 본인 읽기만)
//   - users/{uid}/notifications(앱 안 알림함, 읽음 표시만 본인) → sendCaptureReminders·saveLogLocation·joinJourney·onLogCreated·DAY RECAP 공개 함수
//   - invites, inviteAttempts, publicLogs, sharedRecaps, recaps → 서버 함수
//   (coinDaily·inviteAttempts·invites 는 아래에 match 가 없어서 앱이 읽지도 쓰지도 못한다)
//
// 클라이언트가 쓰는 문서 요약 (필드: 타입, 제한)
//   users/{uid}: nickname 1~20자, photoURL(https 주소 500자 이하 또는 null), createdAt(서버 시각)
//   users/{uid}/devices/{token}: 촬영 알림을 받을 폰(token = 문서 ID, timeZone, platform 'android', updatedAt 서버 시각). 본인만
//   users/{uid}/agreements/{termsVersion}: 약관 동의 기록. ageOver14·terms·location(모두 true 필수),
//     notifyNewLogs(bool), agreedAt(서버 시각). 본인만 읽고, 한 번 만들면 고치거나 지울 수 없다
//   journeys/{journeyId}/members/{uid}: notifyIntervalHours(1|2|3|null)만 본인이 수정,
//     finishedAt(여정 마치기, N01 다운로드 모양 버튼)은 본인이 한 번만 서버 시각으로 넣는다
//     hiddenAt(마이로그에서 지우기, S14 휴지통 버튼)도 본인이 한 번만 서버 시각으로 넣는다
//     coverPath(S01-A 여정 카드 대표 사진, 내 홈에서만 보임)는 본인 폴더의 cover_{시각}.jpg 경로 또는 null 로만 바꾼다
//   journeys/{journeyId}/logs/{logId}:
//     authorId(본인 uid, 변경 불가), mediaType(photo|video|text), mediaPath(본인 폴더 경로 또는 null),
//     body 0~500자, themes(테마 태그 0~3개, 각 1~20자, # 없이), taggedUids(구성원 uid 20개 이하),
//     capturedAt(Timestamp), capturedTz 1~64자, location(생성 시 null), placeName(생성 시 null),
//     isPublic(생성 시 false), createdAt(서버 시각)
//   .../comments/{commentId}: authorId(본인), body 1~500자, createdAt(서버 시각)
//   .../reactions/{uid}: emoji 1~16자, createdAt(서버 시각). 문서 ID가 본인 uid → 1인 1반응
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 공통 도우미 ----------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function journeyData(journeyId) {
      return get(/databases/$(database)/documents/journeys/$(journeyId)).data;
    }

    // 여정 문서의 memberIds에 내가 있는지 확인한다. 여정이 없으면 거부된다.
    function isMember(journeyId) {
      return isAuthenticated() && request.auth.uid in journeyData(journeyId).memberIds;
    }

    function isServerTime(value) {
      return value == request.time;
    }

    function isStringBetween(value, minLen, maxLen) {
      return value is string && value.size() >= minLen && value.size() <= maxLen;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---------- 도메인 검증 ----------

    function isValidUser(data) {
      return data.keys().hasOnly(['nickname', 'photoURL', 'createdAt', 'coins'])
        && data.keys().hasAll(['nickname', 'createdAt'])
        && isStringBetween(data.nickname, 1, 20)
        && (!('photoURL' in data) || data.photoURL == null
            || (isStringBetween(data.photoURL, 9, 500) && data.photoURL.matches('^https://.*')))
        && data.createdAt is timestamp;
    }

    // 약관 동의 기록: 필수 항목(만 14세 이상·서비스 이용약관·위치기반서비스 이용약관)은 모두 동의해야 한다.
    function isValidAgreement(data) {
      return data.keys().hasOnly(['ageOver14', 'terms', 'location', 'notifyNewLogs', 'agreedAt'])
        && data.keys().hasAll(['ageOver14', 'terms', 'location', 'notifyNewLogs', 'agreedAt'])
        && data.ageOver14 == true
        && data.terms == true
        && data.location == true
        && data.notifyNewLogs is bool
        && isServerTime(data.agreedAt);
    }

    // 촬영 알림 기기: token 은 문서 ID 와 같고, timeZone 은 폰 시간대 이름(예: Asia/Seoul), updatedAt 은 서버 시각
    function isValidDevice(data, token) {
      return data.keys().hasOnly(['token', 'timeZone', 'platform', 'updatedAt'])
        && data.keys().hasAll(['token', 'timeZone', 'platform', 'updatedAt'])
        && data.token == token
        && isStringBetween(data.token, 1, 4096)
        && isStringBetween(data.timeZone, 1, 64)
        && data.platform == 'android'
        && isServerTime(data.updatedAt);
    }

    function isValidNotifyInterval(value) {
      return value == null || value in [1, 2, 3];
    }

    // 여정 카드 대표 사진: 이 여정의 본인 폴더에 올린 cover_{시각}.jpg 만 가리킨다(null 이면 기본 그림)
    function isValidCoverPath(value, journeyId, uid) {
      return value == null
        || (value is string && value.size() <= 200
            && value.matches('^journeys/' + journeyId + '/' + uid + '/cover_[0-9]+[.]jpg$'));
    }

    // 기록에서 클라이언트가 정하는 필드를 검증한다. 생성과 수정 모두 이 함수를 거친다.
    function isValidLog(data, journeyId) {
      return data.keys().hasOnly([
          'authorId', 'mediaType', 'mediaPath', 'body', 'themes', 'taggedUids',
          'capturedAt', 'capturedTz', 'location', 'placeName', 'isPublic', 'createdAt'])
        && data.keys().hasAll([
          'authorId', 'mediaType', 'mediaPath', 'body', 'themes', 'taggedUids',
          'capturedAt', 'capturedTz', 'location', 'placeName', 'isPublic', 'createdAt'])
        && data.mediaType in ['photo', 'video', 'text']
        // 글 기록은 미디어가 없고, 사진·영상은 작성자 본인 폴더의 파일만 가리킨다.
        && (data.mediaType == 'text'
              ? data.mediaPath == null
              : (data.mediaPath is string && data.mediaPath.size() <= 300
                 && data.mediaPath.matches('^journeys/' + journeyId + '/' + data.authorId + '/[^/]+$')))
        && isStringBetween(data.body, 0, 500)
        && isValidThemes(data.themes)
        // 태그는 20명 이하, 모두 이 여정의 구성원이어야 한다.
        && data.taggedUids is list && data.taggedUids.size() <= 20
        && data.taggedUids.toSet().difference(journeyData(journeyId).memberIds.toSet()).size() == 0
        && data.capturedAt is timestamp
        && isStringBetween(data.capturedTz, 1, 64)
        && data.isPublic is bool
        && data.createdAt is timestamp;
    }

    // 테마 태그(S05, 인스타그램 해시태그처럼): 0~3개, 각각 1~20자 글자(# 없이 저장)
    function isValidThemes(themes) {
      return themes is list && themes.size() <= 3
        && (themes.size() < 1 || isStringBetween(themes[0], 1, 20))
        && (themes.size() < 2 || isStringBetween(themes[1], 1, 20))
        && (themes.size() < 3 || isStringBetween(themes[2], 1, 20));
    }

    function isValidComment(data) {
      return data.keys().hasOnly(['authorId', 'body', 'createdAt'])
        && data.keys().hasAll(['authorId', 'body', 'createdAt'])
        && isStringBetween(data.body, 1, 500)
        && data.createdAt is timestamp;
    }

    function isValidReaction(data) {
      return data.keys().hasOnly(['emoji', 'createdAt'])
        && data.keys().hasAll(['emoji', 'createdAt'])
        && isStringBetween(data.emoji, 1, 16)
        && isServerTime(data.createdAt);
    }

    // 좋아요·저장 표시: 공개 리캡이 있어야 하고, 목록에 보여 줄 요약(여정 이름·도시·날짜·대표 화면)만 함께 둔다
    function isValidRecapMark(data, recapId) {
      return data.keys().hasOnly(['journeyName', 'city', 'date', 'thumbPath', 'createdAt'])
        && data.keys().hasAll(['journeyName', 'city', 'date', 'thumbPath', 'createdAt'])
        && exists(/databases/$(database)/documents/publicRecaps/$(recapId))
        && isStringBetween(data.journeyName, 1, 100)
        && isStringBetween(data.city, 0, 100)
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (data.thumbPath == null
            || (data.thumbPath is string && data.thumbPath.size() <= 300
                && data.thumbPath.matches('^public/recaps/' + recapId + '/[^/]+$')))
        && isServerTime(data.createdAt);
    }

    // ---------- 사용자 ----------

    match /users/{uid} {
      // 로그인한 사용자는 다른 사람의 닉네임·사진을 볼 수 있다. (이메일 등 개인정보는 넣지 않는다)
      allow read: if isAuthenticated();
      // 본인 문서만 만든다. coins는 넣을 수 없다.
      allow create: if isOwner(uid)
        && isValidUser(request.resource.data)
        && !('coins' in request.resource.data)
        && isServerTime(request.resource.data.createdAt);
      // 본인은 nickname·photoURL만 고친다.
      allow update: if isOwner(uid)
        && changedKeys().hasOnly(['nickname', 'photoURL'])
        && isValidUser(request.resource.data);
      allow delete: if false;

      // 약관 동의 기록(문서 ID = 약관 버전, 예: 2026-10-03). 본인만 읽고, 한 번 만들면 바꿀 수 없다.
      match /agreements/{termsVersion} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && termsVersion.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && isValidAgreement(request.resource.data);
        allow update, delete: if false;
      }

      // 코인 내역은 본인만 읽고, 쓰기는 서버만 한다.
      match /coinLedger/{logId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // 탐색 장소 열람 기록(unlockRecapPlaces 가 20코인을 빼면서 만든다). 본인만 읽고, 쓰기는 서버만
      match /placeUnlocks/{recapId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // 탐색에서 좋아요·저장한 DAY RECAP(모아보기 화면). 본인만 읽고 만들고 지운다(고치지는 않는다)
      match /recapLikes/{recapId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && isValidRecapMark(request.resource.data, recapId);
        allow update: if false;
      }
      match /recapSaves/{recapId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && isValidRecapMark(request.resource.data, recapId);
        allow update: if false;
      }

      // 앱 안 알림함(2026-11-09, 홈 종 버튼 → 알림 목록). 서버 함수만 만든다.
      // 본인만 읽고, 읽음 표시(read: false → true)만 바꿀 수 있다. 제목·내용·종류는 고칠 수 없고 지울 수도 없다.
      match /notifications/{notificationId} {
        allow read: if isOwner(uid);
        allow update: if isOwner(uid)
          && changedKeys().hasOnly(['read'])
          && request.resource.data.read == true;
        allow create, delete: if false;
      }

      // 촬영 알림을 받을 폰(문서 ID = FCM 토큰). 본인만 읽고 쓰고 지운다(로그아웃하면 지운다).
      // 서버 함수 sendCaptureReminders 가 이 토큰·시간대로 폰 시각 09~23시에 알림을 보낸다.
      match /devices/{token} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidDevice(request.resource.data, token);
      }
    }

    // ---------- 여정 ----------

    match /journeys/{journeyId} {
      // 목록은 where('memberIds', 'array-contains', 내 uid) 조건으로 조회해야 한다.
      allow read: if isAuthenticated() && request.auth.uid in resource.data.memberIds;
      // 생성·참여·수정·삭제는 서버 함수로만 한다.
      allow write: if false;

      match /members/{memberId} {
        allow read: if isMember(journeyId);
        // 본인 알림 주기만 바꾼다. role·joinedAt·inviteCode는 바꿀 수 없다.
        // "여정 마치기"(N01): 본인 문서에 finishedAt 을 한 번만, 서버 시각으로 넣는다(나에게만 여정이 끝난다. 되돌릴 수 없음).
        // "마이로그에서 지우기"(S14 휴지통): 본인 문서에 hiddenAt 을 한 번만, 서버 시각으로 넣는다(내 마이로그에서만 사라진다).
        allow update: if isOwner(memberId)
          && isMember(journeyId)
          && (
            (changedKeys().hasOnly(['notifyIntervalHours'])
              && isValidNotifyInterval(request.resource.data.notifyIntervalHours))
            || (changedKeys().hasOnly(['finishedAt'])
              && !('finishedAt' in resource.data)
              && isServerTime(request.resource.data.finishedAt))
            || (changedKeys().hasOnly(['hiddenAt'])
              && !('hiddenAt' in resource.data)
              && isServerTime(request.resource.data.hiddenAt))
            // S01-A 여정 카드 대표 사진(내 홈에서만 보인다): 본인 폴더 사진 경로만
            || (changedKeys().hasOnly(['coverPath'])
              && isValidCoverPath(request.resource.data.coverPath, journeyId, memberId))
          );
        allow create, delete: if false;
      }

      match /logs/{logId} {
        allow read: if isMember(journeyId);

        // 위치·공개 여부는 비워서 만들고, saveLogLocation 함수로만 채운다.
        allow create: if isMember(journeyId)
          && request.resource.data.authorId == request.auth.uid
          && isValidLog(request.resource.data, journeyId)
          && request.resource.data.location == null
          && request.resource.data.placeName == null
          && request.resource.data.isPublic == false
          && isServerTime(request.resource.data.createdAt);

        // 작성자는 글·테마·태그만 고친다.
        allow update: if isMember(journeyId)
          && resource.data.authorId == request.auth.uid
          && changedKeys().hasOnly(['body', 'themes', 'taggedUids'])
          && isValidLog(request.resource.data, journeyId);

        allow delete: if isMember(journeyId) && resource.data.authorId == request.auth.uid;

        match /comments/{commentId} {
          allow read: if isMember(journeyId);
          allow create: if isMember(journeyId)
            && request.resource.data.authorId == request.auth.uid
            && isValidComment(request.resource.data)
            && isServerTime(request.resource.data.createdAt);
          allow update: if isMember(journeyId)
            && resource.data.authorId == request.auth.uid
            && changedKeys().hasOnly(['body'])
            && isValidComment(request.resource.data);
          allow delete: if isMember(journeyId) && resource.data.authorId == request.auth.uid;
        }

        // 문서 ID가 반응한 사람의 uid라서 1인 1반응이 된다.
        match /reactions/{reactorId} {
          allow read: if isMember(journeyId);
          allow create, update: if isOwner(reactorId)
            && isMember(journeyId)
            && isValidReaction(request.resource.data);
          allow delete: if isOwner(reactorId) && isMember(journeyId);
        }
      }

      // 추억 영상 정보는 서버 함수(generateRecapCaptions)가 만든다.
      match /recaps/{recapId} {
        allow read: if isMember(journeyId);
        allow write: if false;
      }
    }

    // ---------- 서버만 쓰는 문서 (일부는 공개 읽기) ----------

    // 초대 요약. 초대 코드가 6자리라 누구나 읽게 두면 여러 코드를 넣어 보는 방식으로 다른 여정이 드러날 수 있다.
    // 그래서 앱은 직접 읽지도 쓰지도 못하고, 서버 함수(createJourney·joinJourney)만 쓴다.
    match /invites/{inviteCode} {
      allow read, write: if false;
    }

    // 초대 코드 입력 횟수(joinJourney 가 하루 횟수 제한에 쓴다). 서버만 쓴다.
    match /inviteAttempts/{uid} {
      allow read, write: if false;
    }

    // 오늘 광고를 보고 코인 받은 횟수(2026-11-11, 하루 5번 · 1번에 2코인). date(UTC "YYYY-MM-DD")·count·updatedAt.
    // 홈 "광고 보고 코인 받기" 팝업의 "오늘 N / 5회 사용"에 쓰려고 본인만 읽는다. 쓰기는 서버 함수 claimAdReward 만.
    match /adDaily/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // 탐색 화면용 공개 기록 사본
    match /publicLogs/{logId} {
      allow read: if true;
      allow write: if false;
    }

    // 탐색 공개 DAY RECAP(S08·S09). 구성원 모두 동의하면 서버(answerRecapPublish)가 만든다. 로그인한 사람은 읽는다.
    // 좌표·장소 이름(places)은 20코인으로 열람한 사람(users/{uid}/placeUnlocks/{recapId})과 그 여정의 구성원만 읽는다.
    match /publicRecaps/{recapId} {
      allow read: if isAuthenticated();
      allow write: if false;

      match /places/{logId} {
        allow read: if isAuthenticated()
          && (exists(/databases/$(database)/documents/users/$(request.auth.uid)/placeUnlocks/$(recapId))
              || request.auth.uid in get(/databases/$(database)/documents/publicRecaps/$(recapId)).data.memberIds);
        allow write: if false;
      }
    }

    // DAY RECAP 탐색 공개 동의 요청. 요청 당시 구성원(memberIds)만 읽고, 쓰기는 서버 함수만
    // (requestRecapPublish·answerRecapPublish). 목록은 where('memberIds', 'array-contains', 내 uid)로 읽는다.
    match /recapPublishRequests/{requestId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.memberIds;
      allow write: if false;
    }

    // 공유한 추억 영상. slug를 아는 사람만 단건으로 읽는다.
    match /sharedRecaps/{slug} {
      allow get: if true;
      allow list, write: if false;
    }
  }
}
