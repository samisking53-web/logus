<?xml version="1.0" encoding="utf-8"?>
<!-- 연필(테두리만): S01-A 여정 카드 대표 사진 바꾸기 버튼(2026-11-04 팀 그림). 심이 왼쪽 아래, 지우개 띠가 오른쪽 위. 색은 코드에서 tint 로 정한다 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 가로로 누운 연필(심이 왼쪽)을 그린 뒤 왼쪽으로 45도 돌린다 -->
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="-45">
        <!-- 몸통 + 깎은 심 -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FF000000"
            android:strokeWidth="1.8"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M7,9H20A2,2 0,0 1,22 11V13A2,2 0,0 1,20 15H7L2,12Z" />
        <!-- 심 쪽 띠 · 지우개 쪽 띠 -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FF000000"
            android:strokeWidth="1.8"
            android:strokeLineCap="round"
            android:pathData="M7,9V15M19,9V15" />
        <!-- 끝의 작은 심 -->
        <path
            android:fillColor="#FF000000"
            android:pathData="M2,12L4.2,10.7L4.2,13.3Z" />
    </group>
</vector>
