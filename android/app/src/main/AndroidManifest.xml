<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 새 여정의 도시 추천에 현재 위치를 쓴다. 도시 이름만 알면 돼서 대략적인 위치만 묻는다 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- L01 위치 확인 지도: 핀을 촬영 위치에 정확히 찍으려고 정확한 위치를 묻는다(거절하면 대략적인 위치·지도 이동으로 고른다) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- S04 앱 내 카메라: 영상 촬영(카메라)과 소리 녹음(마이크). 마이크를 거절하면 소리 없이 찍는다 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- S17 DAY RECAP 영상 다운로드: 안드로이드 9 이하에서 갤러리(동영상 폴더)에 저장할 때만 필요 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- S01-A 대표 사진 선택 팝업: 폰 사진첩 목록을 팝업 안에 보여 준다(고른 한 장만 줄여서 올린다).
         안드로이드 13 이상은 사진만(READ_MEDIA_IMAGES), 14 이상은 "일부 사진만 허용"도, 12 이하는 저장소 읽기 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- 카메라가 없는 기기도 앱을 설치할 수 있게(카메라 화면만 못 쓴다) -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LogUs">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 홈 프로필 사진 수정 팝업의 "사진 찍기": 폰의 카메라 앱이 찍은 사진을 앱 전용 임시 폴더에 쓰게 잠깐 허락한다 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
