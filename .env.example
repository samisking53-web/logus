# 이 파일을 복사해 .env.local 로 만들고 값을 채운다 (.env.local 은 커밋하지 않는다).
# 값은 Firebase 콘솔 > 프로젝트 설정 > 내 앱(웹)에서 확인한다.
# authDomain: 배포 주소에서는 앱 도메인(예: logus.vercel.app), 로컬에서는 logus-80f21.firebaseapp.com (CLAUDE.md "인증" 참고).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=logus-80f21
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
